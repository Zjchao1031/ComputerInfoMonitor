set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR arm)

set(IMX6ULL_CROSS_COMPILER_PREFIX "arm-linux-gnueabihf-" CACHE STRING "Cross compiler executable prefix")
set(IMX6ULL_CROSS_COMPILER_SUFFIX "-13" CACHE STRING "Cross compiler executable suffix")
set(IMX6ULL_SYSROOT "" CACHE PATH "Optional target sysroot")

set(CMAKE_C_COMPILER "${IMX6ULL_CROSS_COMPILER_PREFIX}gcc${IMX6ULL_CROSS_COMPILER_SUFFIX}" CACHE FILEPATH "")
set(CMAKE_CXX_COMPILER "${IMX6ULL_CROSS_COMPILER_PREFIX}g++${IMX6ULL_CROSS_COMPILER_SUFFIX}" CACHE FILEPATH "")

if(IMX6ULL_SYSROOT)
    set(CMAKE_SYSROOT "${IMX6ULL_SYSROOT}" CACHE PATH "")
endif()

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

